#!/usr/bin/env bash
# Thin wrapper so the class-profile plugin exposes a `class-profile` command
# on the Bash tool's PATH. It self-locates the bundled profiler. When the
# plugin is installed from the marketplace, its class_profile.py /
# text_report.py / vocab_profile.py / grammar_profile.py and WordLists /
# GrammarProfile (symlinks back to the repo root) are dereferenced into real
# files, so this resolves directly. Loading a clone in place with --plugin-dir
# instead relies on those external symlinks being followed; if that path isn't
# available, run ../class_profile.py from the repo directly.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
exec python3 "$here/../class_profile.py" "$@"
