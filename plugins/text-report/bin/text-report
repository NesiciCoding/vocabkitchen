#!/usr/bin/env bash
# Thin wrapper so the text-report plugin exposes a `text-report` command on the
# Bash tool's PATH. It self-locates the bundled report script. When the plugin
# is installed from the marketplace, its text_report.py / vocab_profile.py /
# grammar_profile.py and WordLists / GrammarProfile (symlinks back to the repo
# root) are dereferenced into real files, so this resolves directly. Loading a
# clone in place with --plugin-dir instead relies on those external symlinks
# being followed; if that path isn't available, run ../text_report.py from the
# repo directly.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
exec python3 "$here/../text_report.py" "$@"
